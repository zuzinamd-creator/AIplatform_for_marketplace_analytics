[Unit]
Description=Marketplace Analytics Runtime Orchestrator (rebuild dispatch)
Documentation=file:///root/AIplatform_for_marketplace_analytics/docs/runtime/runtime_architecture.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
WorkingDirectory=/root/AIplatform_for_marketplace_analytics
EnvironmentFile=-/root/AIplatform_for_marketplace_analytics/.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/root/AIplatform_for_marketplace_analytics/scripts/preflight-env.sh --systemd
ExecStart=/root/AIplatform_for_marketplace_analytics/.venv/bin/python -m app.runtime.orchestration_worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
